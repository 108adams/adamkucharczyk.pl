{
  "name": "adam-kucharczyk-main-site",
  "version": "0.1.0",
  "private": "true",
  "description": "Adam Kucharczyk's site, based on eleventy-excellent",
  "author": "Adam Kucharczyk",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20.x.x"
  },
  "scripts": {
    "clean": "rimraf dist src/_includes/css",
    "favicons": "node ./src/_config/setup/generate-favicons.js",
    "colors": "node ./src/_config/setup/create-colors.js",
    "dev:11ty": "cross-env ELEVENTY_ENV=development eleventy --serve",
    "build:11ty": "cross-env ELEVENTY_ENV=production eleventy",
    "start": "npm run dev:11ty",
    "build": "npm run clean && npm run build:11ty && npm run check:links",
    "pa11y:build": "npm run clean && cross-env ELEVENTY_ENV=test eleventy",
    "pa11y:test": "sleep 3 && pa11y-ci --config ./dist/pa11y.json",
    "pa11y:serve": "ELEVENTY_ENV=test eleventy --serve --ignore-initial",
    "test:a11y": "npm run pa11y:build && (npm run pa11y:serve &) && sleep 5 && npm run pa11y:test",
    "check:links": "node scripts/check-links.js",
    "test": "node --test scripts/check-links.test.js",
    "prepare": "simple-git-hooks"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/108adams/adamkucharczyk.pl"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "colorjs.io": "^0.6.0",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.2",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^4.1.1",
    "lint-staged": "^17.6.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-link-attributes": "^4.0.1",
    "netlify-plugin-cache": "^1.0.3",
    "pa11y-ci": "^4.0.1",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-import-ext-glob": "^2.1.1",
    "postcss-js": "^5.0.3",
    "prettier": "^3.9.9",
    "prettier-plugin-jinja-template": "^2.1.0",
    "rimraf": "^6.1.2",
    "sharp": "^0.34.5",
    "sharp-ico": "^0.1.5",
    "simple-git-hooks": "^2.14.0",
    "slugify": "^1.6.6",
    "svgo": "^4.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "node scripts/check-commit-msg.js \"$1\"",
    "pre-push": "npm run build"
  },
  "lint-staged": {
    "*.{js,json,css}": "prettier --check"
  }
}
