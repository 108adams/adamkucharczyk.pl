---
eleventyExcludeFromCollections: true
layout: false
permalink: "pa11y.json"
---

{#
  Generates pa11y accessibility test config in test environment.
  Tests all sitemap pages plus meta.tests.pa11y.extraPaths (pages excluded from the sitemap).
#}
{%- set urls = [] -%}
{%- for page in collections.showInSitemap -%}
  {%- if page.url and page.data.excludeFromSitemap != true and page.url.startsWith('/') -%}
    {%- set urls = (urls.push('http://localhost:8080' + page.url), urls) -%}
  {%- endif -%}
{%- endfor -%}

{%- for path in meta.tests.pa11y.extraPaths -%}
  {%- set urls = (urls.push('http://localhost:8080' + path), urls) -%}
{%- endfor -%}

{%- set config = {
  defaults: {
    standard: "WCAG2AA",
    timeout: 10000,
    chromeLaunchConfig: {
      args: ["--no-sandbox", "--disable-setuid-sandbox"]
    }
  },
  urls: urls
} -%}
{{- config | dump(2) | safe }}
